# Copier ce fichier en keystore.properties (à la racine du projet, ignoré par git) et le compléter.
# Sans keystore.properties, la release est signée avec la clé de debug.
# storeFile : chemin du keystore, relatif à la racine du projet ou absolu (le garder hors du dépôt de préférence).
storeFile=C:/Users/VOTRE_COMPTE/cles/invento-upload.jks
storePassword=A_COMPLETER
keyAlias=invento-upload
keyPassword=A_COMPLETER
